# מפתח לחתימת עוגיות ה-session - חובה, תני מחרוזת אקראית וארוכה
SESSION_SECRET=change-me-to-a-long-random-string

# קוד הזמנה שצריך להזין בהרשמה (מייל+סיסמה או חשבון Google חדש)
INVITE_CODE=change-me

# שליחת מיילי אימות דרך Resend (https://resend.com)
RESEND_API_KEY=
# כתובת שולח מאומתת ב-Resend. אפשר להשאיר את ברירת המחדל של Resend לבדיקות
RESEND_FROM_EMAIL="מרחב הרעיונות <onboarding@resend.dev>"

# התחברות עם Google - יוצרים ב-Google Cloud Console > APIs & Services > Credentials
# Authorized redirect URI: <BASE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# נתיב לקובץ ה-DB (אופציונלי, ברירת מחדל: ideas.db בתיקיית הפרויקט)
DB_PATH=
